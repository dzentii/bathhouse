APP_ENV=development
PUBLIC_URL=http://localhost:8080
ALLOWED_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
HTTP_PORT=8080
DOMAIN=booking.example.ru
POSTGRES_PASSWORD=
CATALOG_DB_PASSWORD=
BOOKING_DB_PASSWORD=
PAYMENT_DB_PASSWORD=
IDENTITY_DB_PASSWORD=
REDIS_PASSWORD=
INTERNAL_API_KEY=
ORDER_TOKEN_KEY=
TICKET_TOKEN_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
BACKUP_DIR=./backups

# Ограничения нагрузки (по доверенному IP); для группового оформления до 100 мест.
HTTP_MAX_CONCURRENT=64
PUBLIC_RATE_PER_MINUTE=1200
WRITE_RATE_PER_MINUTE=300
HEAVY_RATE_PER_MINUTE=60
MAX_ACTIVE_HOLDS_PER_CLIENT=5
MAX_HELD_RESOURCES_PER_CLIENT=100
PDF_MAX_CONCURRENT=2
PDF_CACHE_MIB=16
OUTBOX_RETENTION_DAYS=30
INBOX_RETENTION_DAYS=90
APP_GOMAXPROCS=2
